# copy to .env for docker compose
SERVER_SECRET=change-me-to-32-random-bytes-base64
# live sends passages to TypeSafe and costs money
JEV_MODE=synthetic
# which peers may set X-Forwarded-For: the port is bound to 127.0.0.1, so only a proxy on this
# host reaches it and * is safe; narrow it to the proxy's address if you open the port
FORWARDED_ALLOW_IPS=*
