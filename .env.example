# copy to .env for docker compose
SERVER_SECRET=change-me-to-32-random-bytes-base64
JEV_MODE=live
# behind a reverse proxy or tunnel: the Compose network's subnet, from
#   docker network inspect sos_default --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# left unset, every visitor shares one upload count
# FORWARDED_ALLOW_IPS=
